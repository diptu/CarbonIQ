# -----------------------------
# Application Settings
# -----------------------------
APP_NAME=CarbonIQ
BASE_URL=http://127.0.0.1:8000
ENV=development
DEBUG=true
PORT=8000

# -----------------------------
# Database Settings (PostgreSQL)
# -----------------------------
DB_USER=Nazmul
DB_PASSWORD=Hello123
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ima
DB_SSL_MODE=require
# Full URI used by Settings (must be explicit; no variable expansion)
DB_URI=postgresql+asyncpg://Nazmul:Hello123@localhost:5432/ima

DB_POOL_MIN=10
DB_POOL_MAX=50
DB_REPLICA1_HOST=
DB_REPLICA2_HOST=

# -----------------------------
# Redis Settings
# -----------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=3600

# -----------------------------
# Rate Limiting Settings
# -----------------------------
RATE_LIMIT_COUNT=5
RATE_LIMIT_WINDOW=60

# -----------------------------
# Sentry Settings
# -----------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_DEBUG=false
# -----------------------------
# Sanity/Smoke Script Settings
# -----------------------------
TIMEOUT=3
RETRIES=2
