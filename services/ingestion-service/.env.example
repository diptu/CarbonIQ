# Copy to .env and adjust for your environment.

SERVICE_NAME=ingestion-service
API_V1_PREFIX=/api/v1
PORT=8004
ENVIRONMENT=local

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://carboniq:carboniq@localhost:5432/ingestion
DATABASE_ECHO=false

# Object storage (MinIO locally; point at S3 in prod)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=carboniq-ingestion
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=ap-southeast-2
S3_USE_SSL=false

# Celery: RabbitMQ broker + Redis result backend
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set true only for tests/local scripts that need synchronous task execution
# without a running broker.
CELERY_TASK_ALWAYS_EAGER=false

# Auth: JWTs are issued by auth-service and only verified here.
# RS256 in staging/prod (paste auth-service's public key below); HS256 with
# a shared secret is supported for local dev without a running auth-service.
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY=
JWT_HS256_SECRET=local-dev-shared-secret
JWT_ISSUER=auth.service.local
JWT_AUDIENCE=

# Downstream dispatch target
OCR_SERVICE_URL=http://localhost:8005
DISPATCH_TIMEOUT_SECONDS=10.0

MAX_UPLOAD_SIZE_BYTES=26214400
